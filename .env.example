# Environment Configuration for Tesla

# LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB Configuration
CHROMA_COLLECTION_NAME=scientific_documents

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=5
RERANK_TOP_K=3

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

# Streamlit Configuration
STREAMLIT_THEME=dark

# Search Configuration
DUCKDUCKGO_MAX_RESULTS=10
DUCKDUCKGO_TIMEOUT=10

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Agent Configuration
AGENT_TIMEOUT=300
MAX_ITERATIONS=10
TEMPERATURE=0.3

# Feature Flags
ENABLE_WEB_SEARCH=true
ENABLE_RAG=true
ENABLE_MEMORY=true
DEBUG_MODE=false
